{
  "name": "dsh-token-rmb",
  "version": "0.1.0",
  "description": "Inline per-turn token cost in CNY for DeepSeek Harness — shows each turn's estimated cost right after the usage/time indicator, with DeepSeek peak/off-peak pricing.",
  "type": "module",
  "license": "MIT",
  "author": "liuyun",
  "homepage": "https://github.com/liuyun2025/dsh-token-rmb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuyun2025/dsh-token-rmb.git"
  },
  "bugs": {
    "url": "https://github.com/liuyun2025/dsh-token-rmb/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "token",
    "cost",
    "pricing",
    "cny",
    "usage"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check lib/client.js",
    "test": "node test/client.test.cjs"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.2.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cosmokit": "1.8.6",
    "@standard-schema/spec": "1.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible"
      }
    }
  }
}
